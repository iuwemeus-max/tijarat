//@version=6
strategy(
     title="MKR AI Precision X1",
     shorttitle="MKR AI X1",
     overlay=true,
     max_bars_back=1000,
     pyramiding=0,
     process_orders_on_close=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=10
)

//────────────────────────────────────
// KERNEL SETTINGS
//────────────────────────────────────

source = input.source(close, "Kernel Source", group="Kernel")

bandwidth = input.float(
     8.0,
     "Kernel Bandwidth",
     minval=1.0,
     step=0.5,
     group="Kernel"
)

kernelLookback = input.int(
     50,
     "Kernel Lookback",
     minval=10,
     maxval=300,
     group="Kernel"
)

signalSensitivity = input.int(
     1,
     "Direction Confirmation Bars",
     minval=1,
     maxval=5,
     tooltip="Lower values produce more kernel signals.",
     group="Kernel"
)

//────────────────────────────────────
// BOLLINGER BAND SETTINGS
//────────────────────────────────────

bbLength = input.int(
     200,
     "Bollinger Band Length",
     minval=2,
     group="BB200"
)

bbMultiplier = input.float(
     2.0,
     "Bollinger Band Deviation",
     minval=0.1,
     step=0.1,
     group="BB200"
)

outsideMode = input.string(
     "Touch Outside",
     "Outside-Band Requirement",
     options=["Touch Outside", "Close Outside"],
     group="BB200"
)

maximumWaitBars = input.int(
     30,
     "Maximum Re-entry Wait",
     minval=1,
     maxval=200,
     group="BB200"
)

allowSameCandleReentry = input.bool(
     true,
     "Allow Signal Candle to Re-enter",
     group="BB200"
)

//────────────────────────────────────
// SMART CONFIRMATION SETTINGS
//────────────────────────────────────

enableSmartConfirmation = input.bool(
     true,
     "Enable Smart Confirmation",
     tooltip="Requires directional candle strength before accepting the BB200 re-entry signal.",
     group="Smart Confirmation"
)

confirmationMode = input.string(
     "Break Previous High/Low",
     "Confirmation Strength",
     options=["Candle Direction Only", "Break Previous High/Low"],
     group="Smart Confirmation"
)

//────────────────────────────────────
// TRADE SETTINGS
//────────────────────────────────────

enableLong = input.bool(true, "Enable Long Trades", group="Trades")
enableShort = input.bool(true, "Enable Short Trades", group="Trades")
closeOppositeTrade = input.bool(true, "Close Opposite Trade", group="Trades")

stopLossPercent = input.float(
     1.0,
     "Stop-Loss %",
     minval=0.0,
     step=0.1,
     group="Trades"
)

takeProfitPercent = input.float(
     2.0,
     "Take-Profit %",
     minval=0.0,
     step=0.1,
     group="Trades"
)

enableTrailingStop = input.bool(false, "Enable Trailing Stop", group="Trades")

trailingStartPercent = input.float(
     1.0,
     "Trailing Activation Profit %",
     minval=0.1,
     step=0.1,
     group="Trades"
)

trailingDistancePercent = input.float(
     0.5,
     "Trailing Distance %",
     minval=0.1,
     step=0.1,
     group="Trades"
)

//────────────────────────────────────
// DISPLAY SETTINGS
//────────────────────────────────────

showKernel = input.bool(true, "Show Kernel Line", group="Display")
showRawSignals = input.bool(true, "Show Raw Kernel Signals", group="Display")
showSetupSignals = input.bool(true, "Show Outside-Band Setups", group="Display")
showBands = input.bool(true, "Show Bollinger Bands", group="Display")
showGenuineSignals = input.bool(true, "Show Confirmed Signals", group="Display")

//────────────────────────────────────
// GAUSSIAN KERNEL
//────────────────────────────────────

gaussianWeight(float distance, float width) =>
    math.exp(-(distance * distance) / (2.0 * width * width))

//────────────────────────────────────
// NON-REPAINTING KERNEL REGRESSION
//────────────────────────────────────

float weightedSum = 0.0
float weightSum = 0.0

for i = 0 to kernelLookback - 1
    if not na(source[i])
        float weight = gaussianWeight(i, bandwidth)
        weightedSum += source[i] * weight
        weightSum += weight

kernel = weightSum > 0 ? weightedSum / weightSum : na

//────────────────────────────────────
// KERNEL DIRECTION
//────────────────────────────────────

kernelRising = kernel > kernel[signalSensitivity]
kernelFalling = kernel < kernel[signalSensitivity]

rawBuySignal = kernelRising and not kernelRising[1]
rawSellSignal = kernelFalling and not kernelFalling[1]

//────────────────────────────────────
// BOLLINGER BANDS 200
//────────────────────────────────────

bbBasis = ta.sma(close, bbLength)
bbDeviation = ta.stdev(close, bbLength) * bbMultiplier
bbUpper = bbBasis + bbDeviation
bbLower = bbBasis - bbDeviation

//────────────────────────────────────
// OUTSIDE-BAND TESTS
//────────────────────────────────────

buyOutside = outsideMode == "Touch Outside" ? low < bbLower : close < bbLower
sellOutside = outsideMode == "Touch Outside" ? high > bbUpper : close > bbUpper

outsideBuySetup = rawBuySignal and buyOutside
outsideSellSetup = rawSellSignal and sellOutside

//────────────────────────────────────
// STORE SETUPS
//────────────────────────────────────

var bool pendingBuy = false
var bool pendingSell = false
var int buySetupBar = na
var int sellSetupBar = na

if outsideBuySetup
    pendingBuy := true
    buySetupBar := bar_index
    pendingSell := false
    sellSetupBar := na

if outsideSellSetup
    pendingSell := true
    sellSetupBar := bar_index
    pendingBuy := false
    buySetupBar := na

//────────────────────────────────────
// EXPIRE OLD SETUPS
//────────────────────────────────────

if pendingBuy and not na(buySetupBar) and bar_index - buySetupBar > maximumWaitBars
    pendingBuy := false
    buySetupBar := na

if pendingSell and not na(sellSetupBar) and bar_index - sellSetupBar > maximumWaitBars
    pendingSell := false
    sellSetupBar := na

//────────────────────────────────────
// PRICE BACK INSIDE BB200
//────────────────────────────────────

buyBackInside = close > bbLower and close <= bbUpper
sellBackInside = close < bbUpper and close >= bbLower

buyTimingAllowed = not na(buySetupBar) and (allowSameCandleReentry ? bar_index >= buySetupBar : bar_index > buySetupBar)
sellTimingAllowed = not na(sellSetupBar) and (allowSameCandleReentry ? bar_index >= sellSetupBar : bar_index > sellSetupBar)

//────────────────────────────────────
// SMART CANDLE CONFIRMATION
//────────────────────────────────────

bullishCandle = close > open
bearishCandle = close < open

bullishBreak = bullishCandle and close > high[1]
bearishBreak = bearishCandle and close < low[1]

bullishConfirmation =
     not enableSmartConfirmation ? true :
     confirmationMode == "Candle Direction Only" ? bullishCandle : bullishBreak

bearishConfirmation =
     not enableSmartConfirmation ? true :
     confirmationMode == "Candle Direction Only" ? bearishCandle : bearishBreak

//────────────────────────────────────
// CONFIRMED SIGNALS
//────────────────────────────────────

confirmedBuy =
     pendingBuy and
     buyTimingAllowed and
     buyBackInside and
     bullishConfirmation

confirmedSell =
     pendingSell and
     sellTimingAllowed and
     sellBackInside and
     bearishConfirmation

if confirmedBuy
    pendingBuy := false
    buySetupBar := na

if confirmedSell
    pendingSell := false
    sellSetupBar := na

//────────────────────────────────────
// STRATEGY ENTRIES
//────────────────────────────────────

if confirmedBuy and enableLong
    if closeOppositeTrade
        strategy.close("Short", comment="Close Short")
    strategy.entry("Long", strategy.long, comment="Confirmed BUY")

if confirmedSell and enableShort
    if closeOppositeTrade
        strategy.close("Long", comment="Close Long")
    strategy.entry("Short", strategy.short, comment="Confirmed SELL")

//────────────────────────────────────
// FIXED SL AND TP
//────────────────────────────────────

longStopPrice = strategy.position_avg_price * (1.0 - stopLossPercent / 100.0)
longTakeProfitPrice = strategy.position_avg_price * (1.0 + takeProfitPercent / 100.0)
shortStopPrice = strategy.position_avg_price * (1.0 + stopLossPercent / 100.0)
shortTakeProfitPrice = strategy.position_avg_price * (1.0 - takeProfitPercent / 100.0)

//────────────────────────────────────
// TRAILING STOP CALCULATION
//────────────────────────────────────

longTrailingActivation = strategy.position_avg_price * (1.0 + trailingStartPercent / 100.0)
shortTrailingActivation = strategy.position_avg_price * (1.0 - trailingStartPercent / 100.0)

trailingOffsetTicks = math.max(
     1,
     math.round(close * trailingDistancePercent / 100.0 / syminfo.mintick)
)

//────────────────────────────────────
// EXIT ORDERS
//────────────────────────────────────

if strategy.position_size > 0
    if enableTrailingStop
        strategy.exit(
             "Long Exit",
             from_entry="Long",
             stop=stopLossPercent > 0 ? longStopPrice : na,
             limit=takeProfitPercent > 0 ? longTakeProfitPrice : na,
             trail_price=longTrailingActivation,
             trail_offset=trailingOffsetTicks
        )
    else
        strategy.exit(
             "Long Exit",
             from_entry="Long",
             stop=stopLossPercent > 0 ? longStopPrice : na,
             limit=takeProfitPercent > 0 ? longTakeProfitPrice : na
        )

if strategy.position_size < 0
    if enableTrailingStop
        strategy.exit(
             "Short Exit",
             from_entry="Short",
             stop=stopLossPercent > 0 ? shortStopPrice : na,
             limit=takeProfitPercent > 0 ? shortTakeProfitPrice : na,
             trail_price=shortTrailingActivation,
             trail_offset=trailingOffsetTicks
        )
    else
        strategy.exit(
             "Short Exit",
             from_entry="Short",
             stop=stopLossPercent > 0 ? shortStopPrice : na,
             limit=takeProfitPercent > 0 ? shortTakeProfitPrice : na
        )

//────────────────────────────────────
// KERNEL PLOT
//────────────────────────────────────

kernelColor = kernelRising ? color.lime : kernelFalling ? color.red : color.gray

plot(
     showKernel ? kernel : na,
     title="Kernel Regression",
     color=kernelColor,
     linewidth=3
)

//────────────────────────────────────
// BOLLINGER BAND PLOTS
//────────────────────────────────────

basisPlot = plot(
     showBands ? bbBasis : na,
     title="BB200 Basis",
     color=color.yellow,
     linewidth=1
)

upperPlot = plot(
     showBands ? bbUpper : na,
     title="BB200 Upper",
     color=color.blue,
     linewidth=2
)

lowerPlot = plot(
     showBands ? bbLower : na,
     title="BB200 Lower",
     color=color.blue,
     linewidth=2
)

fill(
     upperPlot,
     lowerPlot,
     title="BB200 Area",
     color=color.new(color.blue, 92)
)

//────────────────────────────────────
// RAW KERNEL SIGNALS
//────────────────────────────────────

plotshape(
     showRawSignals and rawBuySignal,
     title="Raw Kernel BUY",
     text="K",
     style=shape.circle,
     location=location.belowbar,
     color=color.new(color.green, 20),
     textcolor=color.white,
     size=size.tiny
)

plotshape(
     showRawSignals and rawSellSignal,
     title="Raw Kernel SELL",
     text="K",
     style=shape.circle,
     location=location.abovebar,
     color=color.new(color.red, 20),
     textcolor=color.white,
     size=size.tiny
)

//────────────────────────────────────
// OUTSIDE-BAND SETUPS
//────────────────────────────────────

plotshape(
     showSetupSignals and outsideBuySetup,
     title="Outside BUY Setup",
     text="BUY\nSETUP",
     style=shape.triangleup,
     location=location.belowbar,
     color=color.aqua,
     textcolor=color.black,
     size=size.small
)

plotshape(
     showSetupSignals and outsideSellSetup,
     title="Outside SELL Setup",
     text="SELL\nSETUP",
     style=shape.triangledown,
     location=location.abovebar,
     color=color.orange,
     textcolor=color.black,
     size=size.small
)

//────────────────────────────────────
// CONFIRMED SIGNALS
//────────────────────────────────────

plotshape(
     showGenuineSignals and confirmedBuy,
     title="Confirmed BUY",
     text="CONFIRMED\nBUY",
     style=shape.labelup,
     location=location.belowbar,
     color=color.green,
     textcolor=color.white,
     size=size.normal
)

plotshape(
     showGenuineSignals and confirmedSell,
     title="Confirmed SELL",
     text="CONFIRMED\nSELL",
     style=shape.labeldown,
     location=location.abovebar,
     color=color.red,
     textcolor=color.white,
     size=size.normal
)

barcolor(confirmedBuy ? color.lime : confirmedSell ? color.red : na)

//────────────────────────────────────
// ALERTS
//────────────────────────────────────

alertcondition(
     confirmedBuy,
     title="MKR AI Precision X1 BUY",
     message="Confirmed BUY: bullish kernel setup occurred outside the lower BB200, price returned inside, and bullish candle confirmation passed."
)

alertcondition(
     confirmedSell,
     title="MKR AI Precision X1 SELL",
     message="Confirmed SELL: bearish kernel setup occurred outside the upper BB200, price returned inside, and bearish candle confirmation passed."
)
