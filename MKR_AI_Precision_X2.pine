//@version=6
strategy("MKR AI Precision X2.2 - Staged Reversal Strategy", shorttitle="MKR AI X2.2", overlay=true, pyramiding=0, process_orders_on_close=true, max_bars_back=1500, max_labels_count=500, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// 1. FOUNDATION
g1 = "1. BB200 + Kernel"
src = input.source(close, "Kernel Source", group=g1)
bandwidth = input.float(8.0, "Kernel Bandwidth", minval=1.0, step=0.5, group=g1)
kLookback = input.int(50, "Kernel Lookback", minval=10, maxval=300, group=g1)
kConfirm = input.int(1, "Kernel Direction Bars", minval=1, maxval=5, group=g1)
bbLength = input.int(200, "BB Length", minval=20, group=g1)
bbMult = input.float(2.0, "BB Deviation", minval=0.1, step=0.1, group=g1)
extremeMode = input.string("Close Outside", "Extreme Requirement", options=["Close Outside", "Touch Outside"], group=g1)
minOvershootATR = input.float(0.05, "Minimum Overshoot in ATR", minval=0.0, step=0.05, group=g1)
setupExpiry = input.int(20, "Setup Expiry Bars", minval=1, maxval=100, group=g1)

// 2. EXHAUSTION
g2 = "2. Exhaustion"
rsiLen = input.int(14, "RSI Length", minval=2, group=g2)
wrLen = input.int(14, "Williams %R Length", minval=2, group=g2)
wickRatio = input.float(1.2, "Minimum Wick / Body", minval=0.0, step=0.1, group=g2)
requireKernel = input.bool(true, "Require Kernel Direction", group=g2)
requireMomentum = input.bool(false, "Require Momentum Turn", group=g2)
requireRejection = input.bool(false, "Require Rejection Candle", group=g2)

// 3. CONFIRMATION
g3 = "3. Confirmation"
requireDirection = input.bool(true, "Require Directional Candle", group=g3)
requireBreak = input.bool(true, "Require Previous Candle Break", group=g3)
useVolume = input.bool(false, "Use Volume Filter", group=g3)
volLen = input.int(20, "Volume Average Length", minval=2, group=g3)
volMult = input.float(1.0, "Volume Multiplier", minval=0.1, step=0.1, group=g3)
useEMA = input.bool(false, "Use EMA200 Bias", group=g3)
emaLen = input.int(200, "EMA Length", minval=20, group=g3)
atrLen = input.int(14, "ATR Length", minval=2, group=g3)
minAtrPct = input.float(0.08, "Minimum ATR %", minval=0.0, step=0.01, group=g3)
maxAtrPct = input.float(5.0, "Maximum ATR %", minval=0.1, step=0.1, group=g3)
maxConfirmBars = input.int(8, "Maximum Confirmation Wait", minval=1, maxval=50, group=g3)

// 4. TRIGGER
g4 = "4. Trigger"
minimumScore = input.int(70, "Minimum Score", minval=0, maxval=100, group=g4)
cooldownBars = input.int(8, "Cooldown Bars", minval=0, maxval=200, group=g4)
allowSameBar = input.bool(false, "Allow Same-Bar Entry", group=g4)

// 5. RISK
g5 = "5. Risk Management"
enableLong = input.bool(true, "Enable Long", group=g5)
enableShort = input.bool(true, "Enable Short", group=g5)
closeOpposite = input.bool(true, "Close Opposite Position", group=g5)
stopLossPct = input.float(0.8, "Stop Loss %", minval=0.0, step=0.1, group=g5)
takeProfitPct = input.float(1.6, "Take Profit %", minval=0.0, step=0.1, group=g5)
useTrailing = input.bool(false, "Enable Trailing Stop", group=g5)
trailActivatePct = input.float(0.8, "Trail Activation %", minval=0.1, step=0.1, group=g5)
trailDistancePct = input.float(0.4, "Trail Distance %", minval=0.1, step=0.1, group=g5)

// 6. DISPLAY
g6 = "6. Display"
showKernel = input.bool(true, "Show Kernel", group=g6)
showBands = input.bool(true, "Show BB200", group=g6)
showEMA = input.bool(true, "Show EMA200", group=g6)
showStages = input.bool(true, "Show Stage Markers", group=g6)
showSignals = input.bool(true, "Show BUY/SELL", group=g6)
showDashboard = input.bool(true, "Show Dashboard", group=g6)

// NON-REPAINTING GAUSSIAN KERNEL
gaussian(float d, float w) => math.exp(-(d * d) / (2.0 * w * w))
float sum = 0.0
float weights = 0.0
for i = 0 to kLookback - 1
    if not na(src[i])
        float wt = gaussian(i, bandwidth)
        sum += src[i] * wt
        weights += wt
kernel = weights > 0 ? sum / weights : na
kernelUp = kernel > kernel[kConfirm]
kernelDown = kernel < kernel[kConfirm]

// BB200, EMA, ATR, MOMENTUM
basis = ta.sma(close, bbLength)
dev = ta.stdev(close, bbLength) * bbMult
upper = basis + dev
lower = basis - dev
ema200 = ta.ema(close, emaLen)
atr = ta.atr(atrLen)
atrPct = close != 0 ? atr / close * 100.0 : 0.0
atrOK = atrPct >= minAtrPct and atrPct <= maxAtrPct
volAvg = ta.sma(volume, volLen)
volOK = not useVolume or volume >= volAvg * volMult
rsi = ta.rsi(close, rsiLen)
wrHigh = ta.highest(high, wrLen)
wrLow = ta.lowest(low, wrLen)
wrRange = wrHigh - wrLow
wr = wrRange != 0 ? -100.0 * (wrHigh - close) / wrRange : -50.0
buyMomentum = rsi > rsi[1] and wr > wr[1]
sellMomentum = rsi < rsi[1] and wr < wr[1]

// CANDLE STRUCTURE
body = math.max(math.abs(close - open), syminfo.mintick)
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
bullReject = lowerWick / body >= wickRatio and close >= open
bearReject = upperWick / body >= wickRatio and close <= open

// STAGE 1: EXTREME
buyOutside = extremeMode == "Close Outside" ? close < lower : low < lower
sellOutside = extremeMode == "Close Outside" ? close > upper : high > upper
buyOver = math.max(lower - low, 0.0)
sellOver = math.max(high - upper, 0.0)
buyExtremeRaw = buyOutside and atr > 0 and buyOver / atr >= minOvershootATR
sellExtremeRaw = sellOutside and atr > 0 and sellOver / atr >= minOvershootATR
newBuyExtreme = buyExtremeRaw and not buyExtremeRaw[1]
newSellExtreme = sellExtremeRaw and not sellExtremeRaw[1]

// SETUP MEMORY
var bool pendingBuy = false
var bool pendingSell = false
var bool buyExhausted = false
var bool sellExhausted = false
var int buySetupBar = na
var int sellSetupBar = na
var int buyExhaustBar = na
var int sellExhaustBar = na
var int lastSignalBar = na

if newBuyExtreme
    pendingBuy := true
    pendingSell := false
    buyExhausted := false
    sellExhausted := false
    buySetupBar := bar_index
    sellSetupBar := na
if newSellExtreme
    pendingSell := true
    pendingBuy := false
    sellExhausted := false
    buyExhausted := false
    sellSetupBar := bar_index
    buySetupBar := na

if pendingBuy and not na(buySetupBar) and bar_index - buySetupBar > setupExpiry
    pendingBuy := false
    buyExhausted := false
if pendingSell and not na(sellSetupBar) and bar_index - sellSetupBar > setupExpiry
    pendingSell := false
    sellExhausted := false

// STAGE 2: EXHAUSTION
buyKernelOK = not requireKernel or kernelUp
sellKernelOK = not requireKernel or kernelDown
buyMomentumOK = not requireMomentum or buyMomentum
sellMomentumOK = not requireMomentum or sellMomentum
buyRejectOK = not requireRejection or bullReject
sellRejectOK = not requireRejection or bearReject
buyExhaustNow = pendingBuy and buyKernelOK and buyMomentumOK and buyRejectOK
sellExhaustNow = pendingSell and sellKernelOK and sellMomentumOK and sellRejectOK

if buyExhaustNow and not buyExhausted
    buyExhausted := true
    buyExhaustBar := bar_index
if sellExhaustNow and not sellExhausted
    sellExhausted := true
    sellExhaustBar := bar_index
if buyExhausted and not na(buyExhaustBar) and bar_index - buyExhaustBar > maxConfirmBars
    pendingBuy := false
    buyExhausted := false
if sellExhausted and not na(sellExhaustBar) and bar_index - sellExhaustBar > maxConfirmBars
    pendingSell := false
    sellExhausted := false

// STAGE 3: RE-ENTRY CONFIRMATION
buyReentry = close > lower and close <= upper
sellReentry = close < upper and close >= lower
buyDirectionOK = not requireDirection or close > open
sellDirectionOK = not requireDirection or close < open
buyBreakOK = not requireBreak or close > high[1]
sellBreakOK = not requireBreak or close < low[1]
buyEMAOK = not useEMA or close > ema200
sellEMAOK = not useEMA or close < ema200
buySameBarOK = allowSameBar or na(buySetupBar) or bar_index > buySetupBar
sellSameBarOK = allowSameBar or na(sellSetupBar) or bar_index > sellSetupBar
buyConfirmed = pendingBuy and buyExhausted and buySameBarOK and buyReentry and buyDirectionOK and buyBreakOK and volOK and atrOK and buyEMAOK
sellConfirmed = pendingSell and sellExhausted and sellSameBarOK and sellReentry and sellDirectionOK and sellBreakOK and volOK and atrOK and sellEMAOK

// WEIGHTED SCORE
buyScore = (buyReentry ? 25 : 0) + (buyKernelOK ? 20 : 0) + (buyMomentum ? 15 : 0) + (bullReject ? 10 : 0) + (buyDirectionOK ? 10 : 0) + (buyBreakOK ? 10 : 0) + (atrOK ? 5 : 0) + (volOK ? 5 : 0)
sellScore = (sellReentry ? 25 : 0) + (sellKernelOK ? 20 : 0) + (sellMomentum ? 15 : 0) + (bearReject ? 10 : 0) + (sellDirectionOK ? 10 : 0) + (sellBreakOK ? 10 : 0) + (atrOK ? 5 : 0) + (volOK ? 5 : 0)
cooldownOK = na(lastSignalBar) or bar_index - lastSignalBar > cooldownBars
finalBuy = buyConfirmed and buyScore >= minimumScore and cooldownOK and strategy.position_size <= 0
finalSell = sellConfirmed and sellScore >= minimumScore and cooldownOK and strategy.position_size >= 0

if finalBuy
    lastSignalBar := bar_index
    pendingBuy := false
    buyExhausted := false
if finalSell
    lastSignalBar := bar_index
    pendingSell := false
    sellExhausted := false

// ORDERS
if finalBuy and enableLong
    if closeOpposite
        strategy.close("Short")
    strategy.entry("Long", strategy.long, comment="X2.2 BUY")
if finalSell and enableShort
    if closeOpposite
        strategy.close("Long")
    strategy.entry("Short", strategy.short, comment="X2.2 SELL")

longSL = strategy.position_avg_price * (1.0 - stopLossPct / 100.0)
longTP = strategy.position_avg_price * (1.0 + takeProfitPct / 100.0)
shortSL = strategy.position_avg_price * (1.0 + stopLossPct / 100.0)
shortTP = strategy.position_avg_price * (1.0 - takeProfitPct / 100.0)
trailTicks = math.max(1, math.round(close * trailDistancePct / 100.0 / syminfo.mintick))
longActivation = strategy.position_avg_price * (1.0 + trailActivatePct / 100.0)
shortActivation = strategy.position_avg_price * (1.0 - trailActivatePct / 100.0)
if strategy.position_size > 0
    if useTrailing
        strategy.exit("Long Exit", "Long", stop=stopLossPct > 0 ? longSL : na, limit=takeProfitPct > 0 ? longTP : na, trail_price=longActivation, trail_offset=trailTicks)
    else
        strategy.exit("Long Exit", "Long", stop=stopLossPct > 0 ? longSL : na, limit=takeProfitPct > 0 ? longTP : na)
if strategy.position_size < 0
    if useTrailing
        strategy.exit("Short Exit", "Short", stop=stopLossPct > 0 ? shortSL : na, limit=takeProfitPct > 0 ? shortTP : na, trail_price=shortActivation, trail_offset=trailTicks)
    else
        strategy.exit("Short Exit", "Short", stop=stopLossPct > 0 ? shortSL : na, limit=takeProfitPct > 0 ? shortTP : na)

// VISUALS
kernelColour = kernelUp ? color.lime : kernelDown ? color.red : color.gray
plot(showKernel ? kernel : na, "Kernel", kernelColour, 3)
bp = plot(showBands ? basis : na, "BB200 Basis", color.yellow)
up = plot(showBands ? upper : na, "BB200 Upper", color.blue, 2)
lp = plot(showBands ? lower : na, "BB200 Lower", color.blue, 2)
fill(up, lp, color.new(color.blue, 92))
plot(showEMA ? ema200 : na, "EMA200", color.fuchsia, 2)
plotshape(showStages and newBuyExtreme, "BUY Extreme", shape.circle, location.belowbar, color.yellow, size=size.tiny, text="1")
plotshape(showStages and newSellExtreme, "SELL Extreme", shape.circle, location.abovebar, color.orange, size=size.tiny, text="1")
plotshape(showStages and buyExhaustNow and not buyExhausted[1], "BUY Exhaustion", shape.circle, location.belowbar, color.aqua, size=size.tiny, text="2")
plotshape(showStages and sellExhaustNow and not sellExhausted[1], "SELL Exhaustion", shape.circle, location.abovebar, color.aqua, size=size.tiny, text="2")
plotshape(showStages and buyConfirmed, "BUY Confirmation", shape.diamond, location.belowbar, color.blue, size=size.tiny, text="3")
plotshape(showStages and sellConfirmed, "SELL Confirmation", shape.diamond, location.abovebar, color.blue, size=size.tiny, text="3")
if showSignals and finalBuy
    label.new(bar_index, low, "BUY " + str.tostring(buyScore) + "%", style=label.style_label_up, color=color.lime, textcolor=color.black)
if showSignals and finalSell
    label.new(bar_index, high, "SELL " + str.tostring(sellScore) + "%", style=label.style_label_down, color=color.red, textcolor=color.white)

// DASHBOARD
stageColour(string stage, bool isBuy) =>
    if stage == "ENTRY"
        isBuy ? color.lime : color.red
    else if stage == "CONFIRM"
        color.aqua
    else if stage == "EXHAUST"
        color.blue
    else if stage == "EXTREME"
        color.orange
    else
        color.silver

buyStage = finalBuy ? "ENTRY" : buyConfirmed ? "CONFIRM" : buyExhausted ? "EXHAUST" : pendingBuy ? "EXTREME" : "WAIT"
sellStage = finalSell ? "ENTRY" : sellConfirmed ? "CONFIRM" : sellExhausted ? "EXHAUST" : pendingSell ? "EXTREME" : "WAIT"
var table dash = table.new(position.top_right, 3, 7, border_width=1)
if barstate.islast
    if showDashboard
        table.cell(dash, 0, 0, "MKR X2.2", bgcolor=color.black, text_color=color.white)
        table.cell(dash, 1, 0, "BUY", bgcolor=color.new(color.green, 55), text_color=color.white)
        table.cell(dash, 2, 0, "SELL", bgcolor=color.new(color.red, 55), text_color=color.white)
        table.cell(dash, 0, 1, "Stage")
        table.cell(dash, 1, 1, buyStage, text_color=stageColour(buyStage, true))
        table.cell(dash, 2, 1, sellStage, text_color=stageColour(sellStage, false))
        table.cell(dash, 0, 2, "Score")
        table.cell(dash, 1, 2, str.tostring(buyScore) + "%", text_color=buyScore >= minimumScore ? color.lime : color.silver)
        table.cell(dash, 2, 2, str.tostring(sellScore) + "%", text_color=sellScore >= minimumScore ? color.red : color.silver)
        table.cell(dash, 0, 3, "Kernel")
        table.cell(dash, 1, 3, kernelUp ? "UP" : "FLAT", text_color=kernelUp ? color.lime : color.gray)
        table.cell(dash, 2, 3, kernelDown ? "DOWN" : "FLAT", text_color=kernelDown ? color.red : color.gray)
        table.cell(dash, 0, 4, "Re-entry")
        table.cell(dash, 1, 4, buyReentry ? "YES" : "NO", text_color=buyReentry ? color.lime : color.gray)
        table.cell(dash, 2, 4, sellReentry ? "YES" : "NO", text_color=sellReentry ? color.red : color.gray)
        table.cell(dash, 0, 5, "ATR")
        table.cell(dash, 1, 5, str.tostring(atrPct, "#.##") + "%", text_color=atrOK ? color.lime : color.orange)
        table.cell(dash, 2, 5, atrOK ? "PASS" : "BLOCK", text_color=atrOK ? color.lime : color.orange)
        table.cell(dash, 0, 6, "Position")
        table.cell(dash, 1, 6, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT", text_color=color.yellow)
        table.cell(dash, 2, 6, cooldownOK ? "READY" : "COOLDOWN", text_color=cooldownOK ? color.lime : color.orange)
    else
        table.clear(dash, 0, 0, 2, 6)

// ALERTS
alertcondition(newBuyExtreme, "X2.2 BUY Extreme", "MKR X2.2 BUY extreme outside BB200")
alertcondition(newSellExtreme, "X2.2 SELL Extreme", "MKR X2.2 SELL extreme outside BB200")
alertcondition(buyConfirmed, "X2.2 BUY Confirmation", "MKR X2.2 BUY confirmation")
alertcondition(sellConfirmed, "X2.2 SELL Confirmation", "MKR X2.2 SELL confirmation")
alertcondition(finalBuy, "X2.2 BUY", "MKR X2.2 BUY entry")
alertcondition(finalSell, "X2.2 SELL", "MKR X2.2 SELL entry")
