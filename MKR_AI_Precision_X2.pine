//@version=6
strategy("MKR AI Precision X2.4 - Guarded Staged Reversal", shorttitle="MKR AI X2.4", overlay=true, pyramiding=0, process_orders_on_close=true, max_bars_back=1500, max_labels_count=500, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

gFoundation = "1. BB200 + Kernel Foundation"
src = input.source(close, "Kernel Source", group=gFoundation)
bandwidth = input.float(8.0, "Kernel Bandwidth", minval=1.0, step=0.5, group=gFoundation)
kLookback = input.int(50, "Kernel Lookback", minval=10, maxval=300, group=gFoundation)
kConfirm = input.int(1, "Kernel Direction Bars", minval=1, maxval=5, group=gFoundation)
bbLength = input.int(200, "BB Length", minval=20, group=gFoundation)
bbMult = input.float(2.0, "BB Deviation", minval=0.1, step=0.1, group=gFoundation)
extremeMode = input.string("Close Outside", "Extreme Requirement", options=["Close Outside", "Touch Outside"], group=gFoundation)
minOvershootATR = input.float(0.05, "Minimum Overshoot in ATR", minval=0.0, step=0.05, group=gFoundation)
setupExpiry = input.int(20, "Setup Expiry Bars", minval=1, maxval=100, group=gFoundation)
resetInsideBars = input.int(2, "Inside-Band Bars Before New Setup", minval=1, maxval=10, group=gFoundation)

gExhaustion = "2. Exhaustion"
rsiLen = input.int(14, "RSI Length", minval=2, group=gExhaustion)
wrLen = input.int(14, "Williams %R Length", minval=2, group=gExhaustion)
wickRatio = input.float(1.2, "Minimum Rejection Wick / Body", minval=0.0, step=0.1, group=gExhaustion)
requireKernelTurn = input.bool(true, "Require Kernel Direction", group=gExhaustion)
requireMomentumTurn = input.bool(false, "Require Momentum Turn", group=gExhaustion)
requireRejectionCandle = input.bool(false, "Require Rejection Candle", group=gExhaustion)

gConfirm = "3. Trend Guard + Confirmation"
triggerMode = input.string("Early", "Trigger Mode", options=["Early", "Confirmed"], group=gConfirm)
requireDirectionalClose = input.bool(true, "Require Directional Candle", group=gConfirm)
useVolumeFilter = input.bool(false, "Use Volume Filter", group=gConfirm)
volumeLength = input.int(20, "Volume Average Length", minval=2, group=gConfirm)
volumeMultiplier = input.float(1.0, "Minimum Volume Multiplier", minval=0.1, step=0.1, group=gConfirm)
emaLength = input.int(200, "EMA Length", minval=20, group=gConfirm)
emaSlopeBars = input.int(5, "EMA Slope Bars", minval=1, maxval=50, group=gConfirm)
useTrendGuard = input.bool(true, "Use Strong-Trend Protection", group=gConfirm)
adxLength = input.int(14, "ADX Length", minval=2, group=gConfirm)
strongTrendADX = input.float(22.0, "Strong Trend ADX", minval=1.0, step=0.5, group=gConfirm)
useHTFFilter = input.bool(true, "Use Higher-Timeframe Filter", group=gConfirm)
htfTimeframe = input.timeframe("5", "Higher Timeframe", group=gConfirm)
atrLen = input.int(14, "ATR Length", minval=2, group=gConfirm)
minAtrPercent = input.float(0.08, "Minimum ATR %", minval=0.0, step=0.01, group=gConfirm)
maxAtrPercent = input.float(5.0, "Maximum ATR %", minval=0.1, step=0.1, group=gConfirm)
maxConfirmBars = input.int(8, "Maximum Confirmation Wait", minval=1, maxval=50, group=gConfirm)

gTrigger = "4. Trigger Control"
preset = input.string("Balanced", "Preset", options=["Aggressive", "Balanced", "Safe", "Custom"], group=gTrigger)
customMinimumScore = input.int(70, "Custom Minimum Score", minval=0, maxval=100, group=gTrigger)
cooldownBars = input.int(8, "Signal Cooldown Bars", minval=0, maxval=200, group=gTrigger)
allowSameBarEntry = input.bool(false, "Allow Same-Bar Setup and Entry", group=gTrigger)
oneSignalPerSetup = input.bool(true, "One Signal Per Setup", group=gTrigger)
minimumScore = preset == "Aggressive" ? 65 : preset == "Balanced" ? 70 : preset == "Safe" ? 78 : customMinimumScore
confirmedMode = preset == "Safe" or triggerMode == "Confirmed"

gRisk = "5. Risk Management"
enableLong = input.bool(true, "Enable Long", group=gRisk)
enableShort = input.bool(true, "Enable Short", group=gRisk)
closeOpposite = input.bool(true, "Close Opposite Position", group=gRisk)
exitMode = input.string("ATR", "Exit Mode", options=["ATR", "Percent"], group=gRisk)
stopLossPct = input.float(0.8, "Stop Loss %", minval=0.0, step=0.1, group=gRisk)
takeProfitPct = input.float(1.6, "Take Profit %", minval=0.0, step=0.1, group=gRisk)
atrStopMult = input.float(1.3, "ATR Stop Multiplier", minval=0.1, step=0.1, group=gRisk)
atrTargetMult = input.float(2.0, "ATR Target Multiplier", minval=0.1, step=0.1, group=gRisk)
useTrailing = input.bool(false, "Enable Trailing Stop", group=gRisk)
trailDistanceATR = input.float(1.0, "Trailing Distance ATR", minval=0.1, step=0.1, group=gRisk)

gDisplay = "6. Display"
showKernel = input.bool(true, "Show Kernel", group=gDisplay)
showBands = input.bool(true, "Show BB200", group=gDisplay)
showEMA = input.bool(true, "Show EMA200", group=gDisplay)
showSetupDots = input.bool(true, "Show Setup Dots", group=gDisplay)
showInternalStages = input.bool(false, "Show Internal Stage Markers", group=gDisplay)
showSignals = input.bool(true, "Show BUY/SELL Labels", group=gDisplay)
showDashboard = input.bool(true, "Show Dashboard", group=gDisplay)
showBackground = input.bool(false, "Show Bias Background", group=gDisplay)

gaussianWeight(float distance, float width) => math.exp(-(distance * distance) / (2.0 * width * width))
float weightedSum = 0.0
float weightSum = 0.0
for i = 0 to kLookback - 1
    if not na(src[i])
        float w = gaussianWeight(i, bandwidth)
        weightedSum += src[i] * w
        weightSum += w
kernel = weightSum > 0 ? weightedSum / weightSum : na
kernelRising = kernel > kernel[kConfirm]
kernelFalling = kernel < kernel[kConfirm]
kernelBuyTurn = kernelRising and not kernelRising[1]
kernelSellTurn = kernelFalling and not kernelFalling[1]

bbBasis = ta.sma(close, bbLength)
bbDev = ta.stdev(close, bbLength) * bbMult
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev
insideBands = close < bbUpper and close > bbLower
emaBias = ta.ema(close, emaLength)
emaRising = emaBias > emaBias[emaSlopeBars]
emaFalling = emaBias < emaBias[emaSlopeBars]
atr = ta.atr(atrLen)
atrPct = close != 0 ? atr / close * 100.0 : 0.0
volatilityOK = atrPct >= minAtrPercent and atrPct <= maxAtrPercent
volumeAvg = ta.sma(volume, volumeLength)
volumeOK = not useVolumeFilter or volume >= volumeAvg * volumeMultiplier
[diPlus, diMinus, adx] = ta.dmi(adxLength, adxLength)
strongBullTrend = adx >= strongTrendADX and diPlus > diMinus and close > emaBias and emaRising and kernelRising
strongBearTrend = adx >= strongTrendADX and diMinus > diPlus and close < emaBias and emaFalling and kernelFalling
htfClose = request.security(syminfo.tickerid, htfTimeframe, close, barmerge.gaps_off, barmerge.lookahead_off)
htfEMA = request.security(syminfo.tickerid, htfTimeframe, ta.ema(close, emaLength), barmerge.gaps_off, barmerge.lookahead_off)
htfBull = htfClose >= htfEMA
htfBear = htfClose <= htfEMA
buyTrendGuardOK = not useTrendGuard or not strongBearTrend
sellTrendGuardOK = not useTrendGuard or not strongBullTrend
buyHTFOK = not useHTFFilter or not htfBear
sellHTFOK = not useHTFFilter or not htfBull

buyOutside = extremeMode == "Close Outside" ? close < bbLower : low < bbLower
sellOutside = extremeMode == "Close Outside" ? close > bbUpper : high > bbUpper
buyOvershoot = math.max(bbLower - low, 0.0)
sellOvershoot = math.max(high - bbUpper, 0.0)
buyOvershootOK = atr > 0 ? buyOvershoot / atr >= minOvershootATR : false
sellOvershootOK = atr > 0 ? sellOvershoot / atr >= minOvershootATR : false
rawBuyExtreme = buyOutside and buyOvershootOK
rawSellExtreme = sellOutside and sellOvershootOK
var int insideCount = 0
insideCount := insideBands ? insideCount + 1 : 0
var bool buyExcursionLocked = false
var bool sellExcursionLocked = false
if insideCount >= resetInsideBars
    buyExcursionLocked := false
    sellExcursionLocked := false
newBuyExtreme = rawBuyExtreme and not buyExcursionLocked
newSellExtreme = rawSellExtreme and not sellExcursionLocked
if newBuyExtreme
    buyExcursionLocked := true
if newSellExtreme
    sellExcursionLocked := true

var bool pendingBuy = false
var bool pendingSell = false
var bool buyExhausted = false
var bool sellExhausted = false
var int buySetupBar = na
var int sellSetupBar = na
var int buyExhaustionBar = na
var int sellExhaustionBar = na
var bool buySignalUsed = false
var bool sellSignalUsed = false
if newBuyExtreme
    pendingBuy := true
    pendingSell := false
    buyExhausted := false
    sellExhausted := false
    buySetupBar := bar_index
    sellSetupBar := na
    buyExhaustionBar := na
    sellExhaustionBar := na
    buySignalUsed := false
    sellSignalUsed := false
if newSellExtreme
    pendingSell := true
    pendingBuy := false
    sellExhausted := false
    buyExhausted := false
    sellSetupBar := bar_index
    buySetupBar := na
    sellExhaustionBar := na
    buyExhaustionBar := na
    sellSignalUsed := false
    buySignalUsed := false
if pendingBuy and not na(buySetupBar) and bar_index - buySetupBar > setupExpiry
    pendingBuy := false
    buyExhausted := false
if pendingSell and not na(sellSetupBar) and bar_index - sellSetupBar > setupExpiry
    pendingSell := false
    sellExhausted := false

bodySize = math.max(math.abs(close - open), syminfo.mintick)
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
bullishRejection = lowerWick / bodySize >= wickRatio and close >= open
bearishRejection = upperWick / bodySize >= wickRatio and close <= open
rsi = ta.rsi(close, rsiLen)
wrHigh = ta.highest(high, wrLen)
wrLow = ta.lowest(low, wrLen)
wrRange = wrHigh - wrLow
williamsR = wrRange != 0 ? -100.0 * (wrHigh - close) / wrRange : -50.0
buyMomentumTurn = rsi > rsi[1] and williamsR > williamsR[1]
sellMomentumTurn = rsi < rsi[1] and williamsR < williamsR[1]
buyKernelOK = not requireKernelTurn or kernelBuyTurn or kernelRising
sellKernelOK = not requireKernelTurn or kernelSellTurn or kernelFalling
buyMomentumOK = not requireMomentumTurn or buyMomentumTurn
sellMomentumOK = not requireMomentumTurn or sellMomentumTurn
buyRejectionOK = not requireRejectionCandle or bullishRejection
sellRejectionOK = not requireRejectionCandle or bearishRejection
buyExhaustionNow = pendingBuy and buyKernelOK and buyMomentumOK and buyRejectionOK
sellExhaustionNow = pendingSell and sellKernelOK and sellMomentumOK and sellRejectionOK
if buyExhaustionNow and not buyExhausted
    buyExhausted := true
    buyExhaustionBar := bar_index
if sellExhaustionNow and not sellExhausted
    sellExhausted := true
    sellExhaustionBar := bar_index
if buyExhausted and not na(buyExhaustionBar) and bar_index - buyExhaustionBar > maxConfirmBars
    pendingBuy := false
    buyExhausted := false
if sellExhausted and not na(sellExhaustionBar) and bar_index - sellExhaustionBar > maxConfirmBars
    pendingSell := false
    sellExhausted := false

buyReentry = pendingBuy and close > bbLower
sellReentry = pendingSell and close < bbUpper
bullCandle = close > open
bearCandle = close < open
buyDirectionalOK = not requireDirectionalClose or bullCandle
sellDirectionalOK = not requireDirectionalClose or bearCandle
buyBreakOK = not confirmedMode or close > high[1]
sellBreakOK = not confirmedMode or close < low[1]
sameBarBuyOK = allowSameBarEntry or na(buySetupBar) or bar_index > buySetupBar
sameBarSellOK = allowSameBarEntry or na(sellSetupBar) or bar_index > sellSetupBar
buyConfirmed = pendingBuy and buyExhausted and sameBarBuyOK and buyReentry and buyDirectionalOK and buyBreakOK and volumeOK and volatilityOK and buyTrendGuardOK and buyHTFOK
sellConfirmed = pendingSell and sellExhausted and sameBarSellOK and sellReentry and sellDirectionalOK and sellBreakOK and volumeOK and volatilityOK and sellTrendGuardOK and sellHTFOK
buyRawScore = (buyReentry ? 25 : 0) + (buyKernelOK ? 20 : 0) + (buyMomentumTurn ? 15 : 0) + (bullishRejection ? 10 : 0) + (buyDirectionalOK ? 10 : 0) + (buyBreakOK ? 10 : 0) + (volatilityOK ? 5 : 0) + (volumeOK ? 5 : 0)
sellRawScore = (sellReentry ? 25 : 0) + (sellKernelOK ? 20 : 0) + (sellMomentumTurn ? 15 : 0) + (bearishRejection ? 10 : 0) + (sellDirectionalOK ? 10 : 0) + (sellBreakOK ? 10 : 0) + (volatilityOK ? 5 : 0) + (volumeOK ? 5 : 0)
buyScore = pendingBuy ? buyRawScore : 0
sellScore = pendingSell ? sellRawScore : 0
buyApproved = buyConfirmed and buyScore >= minimumScore
sellApproved = sellConfirmed and sellScore >= minimumScore
var int lastSignalBar = na
cooldownOK = na(lastSignalBar) or bar_index - lastSignalBar > cooldownBars
buyUnusedOK = not oneSignalPerSetup or not buySignalUsed
sellUnusedOK = not oneSignalPerSetup or not sellSignalUsed
finalBuy = buyApproved and cooldownOK and buyUnusedOK and strategy.position_size <= 0
finalSell = sellApproved and cooldownOK and sellUnusedOK and strategy.position_size >= 0
if finalBuy
    lastSignalBar := bar_index
    buySignalUsed := true
    pendingBuy := false
    buyExhausted := false
if finalSell
    lastSignalBar := bar_index
    sellSignalUsed := true
    pendingSell := false
    sellExhausted := false

if finalBuy and enableLong
    if closeOpposite
        strategy.close("Short", comment="Close Short")
    strategy.entry("Long", strategy.long, comment="X2.4 BUY")
if finalSell and enableShort
    if closeOpposite
        strategy.close("Long", comment="Close Long")
    strategy.entry("Short", strategy.short, comment="X2.4 SELL")
var float entryATR = na
if strategy.position_size != 0 and strategy.position_size[1] == 0
    entryATR := atr
if strategy.position_size == 0
    entryATR := na
riskATR = na(entryATR) ? atr : entryATR
longSL = exitMode == "ATR" ? strategy.position_avg_price - riskATR * atrStopMult : strategy.position_avg_price * (1.0 - stopLossPct / 100.0)
longTP = exitMode == "ATR" ? strategy.position_avg_price + riskATR * atrTargetMult : strategy.position_avg_price * (1.0 + takeProfitPct / 100.0)
shortSL = exitMode == "ATR" ? strategy.position_avg_price + riskATR * atrStopMult : strategy.position_avg_price * (1.0 + stopLossPct / 100.0)
shortTP = exitMode == "ATR" ? strategy.position_avg_price - riskATR * atrTargetMult : strategy.position_avg_price * (1.0 - takeProfitPct / 100.0)
trailTicks = math.max(1, math.round(riskATR * trailDistanceATR / syminfo.mintick))
if strategy.position_size > 0
    if useTrailing
        strategy.exit("Long Exit", from_entry="Long", stop=longSL, limit=longTP, trail_points=trailTicks, trail_offset=trailTicks)
    else
        strategy.exit("Long Exit", from_entry="Long", stop=longSL, limit=longTP)
if strategy.position_size < 0
    if useTrailing
        strategy.exit("Short Exit", from_entry="Short", stop=shortSL, limit=shortTP, trail_points=trailTicks, trail_offset=trailTicks)
    else
        strategy.exit("Short Exit", from_entry="Short", stop=shortSL, limit=shortTP)

buyReason = not pendingBuy ? "NO SETUP" : not buyExhausted ? "WAIT KERNEL" : not buyReentry ? "WAIT RE-ENTRY" : not buyTrendGuardOK ? "TREND BLOCK" : not buyHTFOK ? "HTF BLOCK" : not volatilityOK ? "ATR BLOCK" : not volumeOK ? "VOLUME BLOCK" : not buyBreakOK ? "WAIT BREAK" : buyScore < minimumScore ? "SCORE LOW" : not cooldownOK ? "COOLDOWN" : "READY"
sellReason = not pendingSell ? "NO SETUP" : not sellExhausted ? "WAIT KERNEL" : not sellReentry ? "WAIT RE-ENTRY" : not sellTrendGuardOK ? "TREND BLOCK" : not sellHTFOK ? "HTF BLOCK" : not volatilityOK ? "ATR BLOCK" : not volumeOK ? "VOLUME BLOCK" : not sellBreakOK ? "WAIT BREAK" : sellScore < minimumScore ? "SCORE LOW" : not cooldownOK ? "COOLDOWN" : "READY"

kernelColor = kernelRising ? color.lime : kernelFalling ? color.red : color.gray
plot(showKernel ? kernel : na, "Kernel", kernelColor, 3)
plot(showBands ? bbBasis : na, "BB200 Basis", color.yellow)
upperPlot = plot(showBands ? bbUpper : na, "BB200 Upper", color.blue, 2)
lowerPlot = plot(showBands ? bbLower : na, "BB200 Lower", color.blue, 2)
fill(upperPlot, lowerPlot, color=color.new(color.blue, 92))
plot(showEMA ? emaBias : na, "EMA200", color.fuchsia, 2)
plotshape(showSetupDots and newBuyExtreme, "BUY Setup", shape.circle, location.belowbar, color.yellow, size=size.tiny)
plotshape(showSetupDots and newSellExtreme, "SELL Setup", shape.circle, location.abovebar, color.orange, size=size.tiny)
plotshape(showInternalStages and buyExhaustionNow and not buyExhausted[1], "BUY Exhaustion", shape.circle, location.belowbar, color.aqua, size=size.tiny, text="2")
plotshape(showInternalStages and sellExhaustionNow and not sellExhausted[1], "SELL Exhaustion", shape.circle, location.abovebar, color.aqua, size=size.tiny, text="2")
if showSignals and finalBuy
    label.new(bar_index, low, "BUY " + str.tostring(buyScore) + "%", style=label.style_label_up, color=color.lime, textcolor=color.black, size=size.small)
if showSignals and finalSell
    label.new(bar_index, high, "SELL " + str.tostring(sellScore) + "%", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)
bias = buyScore > sellScore ? 1 : sellScore > buyScore ? -1 : 0
bgcolor(showBackground ? (bias == 1 ? color.new(color.green, 93) : bias == -1 ? color.new(color.red, 93) : na) : na)

var table dash = table.new(position.top_right, 3, 11, border_width=1)
if barstate.islast
    if showDashboard
        table.cell(dash, 0, 0, "MKR X2.4", bgcolor=color.black, text_color=color.white)
        table.cell(dash, 1, 0, "BUY", bgcolor=color.new(color.green, 55), text_color=color.white)
        table.cell(dash, 2, 0, "SELL", bgcolor=color.new(color.red, 55), text_color=color.white)
        table.cell(dash, 0, 1, "Reason")
        table.cell(dash, 1, 1, buyReason, text_color=buyReason == "READY" ? color.lime : color.silver)
        table.cell(dash, 2, 1, sellReason, text_color=sellReason == "READY" ? color.red : color.silver)
        table.cell(dash, 0, 2, "Score")
        table.cell(dash, 1, 2, str.tostring(buyScore) + "%")
        table.cell(dash, 2, 2, str.tostring(sellScore) + "%")
        table.cell(dash, 0, 3, "Kernel")
        table.cell(dash, 1, 3, kernelRising ? "UP" : "FLAT", text_color=kernelRising ? color.lime : color.gray)
        table.cell(dash, 2, 3, kernelFalling ? "DOWN" : "FLAT", text_color=kernelFalling ? color.red : color.gray)
        table.cell(dash, 0, 4, "Re-entry")
        table.cell(dash, 1, 4, buyReentry ? "YES" : "NO", text_color=buyReentry ? color.lime : color.gray)
        table.cell(dash, 2, 4, sellReentry ? "YES" : "NO", text_color=sellReentry ? color.red : color.gray)
        table.cell(dash, 0, 5, "Trend Guard")
        table.cell(dash, 1, 5, buyTrendGuardOK ? "PASS" : "BLOCK", text_color=buyTrendGuardOK ? color.lime : color.orange)
        table.cell(dash, 2, 5, sellTrendGuardOK ? "PASS" : "BLOCK", text_color=sellTrendGuardOK ? color.lime : color.orange)
        table.cell(dash, 0, 6, "HTF")
        table.cell(dash, 1, 6, buyHTFOK ? "PASS" : "BLOCK", text_color=buyHTFOK ? color.lime : color.orange)
        table.cell(dash, 2, 6, sellHTFOK ? "PASS" : "BLOCK", text_color=sellHTFOK ? color.lime : color.orange)
        table.cell(dash, 0, 7, "ADX")
        table.cell(dash, 1, 7, str.tostring(adx, "#.0"))
        table.cell(dash, 2, 7, adx >= strongTrendADX ? "STRONG" : "NORMAL")
        table.cell(dash, 0, 8, "ATR %")
        table.cell(dash, 1, 8, str.tostring(atrPct, "#.##") + "%")
        table.cell(dash, 2, 8, volatilityOK ? "PASS" : "BLOCK", text_color=volatilityOK ? color.lime : color.orange)
        table.cell(dash, 0, 9, "Preset")
        table.cell(dash, 1, 9, preset)
        table.cell(dash, 2, 9, confirmedMode ? "CONFIRM" : "EARLY")
        table.cell(dash, 0, 10, "Position")
        table.cell(dash, 1, 10, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT", text_color=color.yellow)
        table.cell(dash, 2, 10, exitMode)
    else
        table.clear(dash, 0, 0, 2, 10)

alertcondition(newBuyExtreme, "MKR X2.4 BUY Setup", "MKR AI X2.4: BUY setup outside BB200")
alertcondition(newSellExtreme, "MKR X2.4 SELL Setup", "MKR AI X2.4: SELL setup outside BB200")
alertcondition(finalBuy, "MKR X2.4 BUY", "MKR AI X2.4: BUY entry confirmed")
alertcondition(finalSell, "MKR X2.4 SELL", "MKR AI X2.4: SELL entry confirmed")
